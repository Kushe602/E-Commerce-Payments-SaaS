# Copy to .env and adjust. Every value has a safe default in app/config.py,
# so the app also runs with no .env at all (fake payments, local SQLite).

# --- Core --------------------------------------------------------------------
# Signs the JWT session cookie. Use a long, random value in production.
SECRET_KEY=change-me-to-a-long-random-value

# SQLAlchemy async URL. Default is local SQLite; for Postgres use asyncpg:
#   postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./cartify.db

# Mark the session cookie Secure (HTTPS only). Keep false for plain-http dev.
COOKIE_SECURE=false

# Create the schema and load demo products/users on startup when empty.
AUTO_SEED=true

# --- Payments ----------------------------------------------------------------
# Leave STRIPE_SECRET_KEY unset to use the built-in deterministic FAKE provider
# (no network, no keys) — the default for local dev, CI, and the hosted demo.
#
# To exercise real Stripe TEST mode, set all three below (test keys only) and
# leave FORCE_FAKE_PAYMENTS unset/false:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Pin the fake provider even if a Stripe key happens to be present.
FORCE_FAKE_PAYMENTS=false

# Optional absolute base URL used to build Stripe return URLs. When unset the
# app derives it from the incoming request.
# BASE_URL=https://your-app.onrender.com
